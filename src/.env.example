#APP
APP_NAME=rag_finance
APP_VERSION=1.0.0
OPENAI_API_KEY=

#FILE
FILE_ALLOWED_TYPES= ["text/plain","application/pdf"]
FILE_MAX_SIZE= 10
FILE_DEFAULT_CHUNK_SIZE= 512000 # 512 kb

#BAM API KEYS
CLE_API_CHANGES=
CLE_API_CHANGES_2=
CLE_API_BDT=
CLE_API_BDT_2=
CLE_API_OBLIG=
CLE_API_OBLIG_2=

#POSTGRES
POSTGRES_USERNAME=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_MAIN_DATABASE="minirag"

# ========================= LLM Config =========================
# Generation Backend: "openai" or "cohere"
GENERATION_BACKEND = "openai"
GENERATION_MODEL_ID="gpt-3.5-turbo-0125"
GENERATION_DAFAULT_MAX_TOKENS=200
GENERATION_DAFAULT_TEMPERATURE=0.1

# Embedding Backend: "local" (HuggingFace - FREE), "openai", or "cohere"
EMBEDDING_BACKEND = "local"

# For local embeddings (HuggingFace):
# Options: "multilingual" (768 dims), "multilingual-mini" (384 dims), "english" (768 dims), "english-mini" (384 dims)
# Or use full HuggingFace model name: "sentence-transformers/paraphrase-multilingual-mpnet-base-v2"
EMBEDDING_MODEL_ID="multilingual"
EMBEDDING_MODEL_SIZE=768
EMBEDDING_DEVICE="cpu"  # or "cuda" if GPU available

# API Keys (only needed if EMBEDDING_BACKEND != "local" or GENERATION_BACKEND != "local")
OPENAI_API_KEY=""
OPENAI_API_URL=
COHERE_API_KEY=""

# Legacy settings (kept for backward compatibility)
GENERATION_MODEL_ID_LITERAL = ["gemma2:9b-instruct-q5_0","gpt-4o-mini", "gpt-4o"]
INPUT_DAFAULT_MAX_CHARACTERS=1024

# ========================= Vector DB Config =========================
VECTOR_DB_BACKEND_LITERAL = ["QDRANT", "PGVECTOR"]
VECTOR_DB_BACKEND = "PGVECTOR"
VECTOR_DB_PATH = "qdrant_db"
VECTOR_DB_DISTANCE_METHOD = "cosine"
VECTOR_DB_PGVEC_INDEX_THRESHOLD =

# ========================= Template Configs =========================
PRIMARY_LANG = "en"
DEFAULT_LANG = "en"